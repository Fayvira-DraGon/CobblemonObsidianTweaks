	"id": "${mod_id}",
	"version": "${mod_version}",
	"name": "${mod_archives_name}",
	"description": "${mod_description}",
	"authors": [
		"${mod_authors}"
	],
	"credits": [
		"${mod_credits}"
	],
	"contact": {
		"modrinth": "${mod_modrinth}",
		"sources": "${mod_github}"
	},
	"license": "${mod_license}",
	"icon": "assets/cobblemon_obsidian_tweaks/icon.png",
